[flake8]
max-line-length = 120
# src/gtfs_garage_gen is generated by scripts/api-gen.sh. Linting it would
# mean editing it, and edited generated code is code nobody dares regenerate.
exclude = .git,__pycache__,__init__.py,.mypy_cache,.pytest_cache,venv,.venv,build,dist,node_modules,web/dist,src/gtfs_garage_gen,.*
# Ignored because it conflicts with black
extend-ignore = E203
